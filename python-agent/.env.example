# 复制为 .env 后填入真实值；.env 含密钥，不要提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 单次模型请求超时（秒）；自动重试会累加延迟，默认关闭。
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
# 每轮模型/工具图最多执行步数，不是 HTTP 总耗时。
AGENT_RECURSION_LIMIT=12
# 进程内会话：闲置过期秒数、最大会话数、保留最近完整用户轮数。
AGENT_MEMORY_TTL_SECONDS=1800
AGENT_MEMORY_MAX_SESSIONS=1000
AGENT_MEMORY_MAX_TURNS=10
# 同用户同 requestId 的执行事实与回复缓存；满额时拒绝新请求，保留未过期结果。
REQUEST_CACHE_TTL_SECONDS=600
REQUEST_CACHE_MAX_ENTRIES=1000
JAVA_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=dev-internal-token-123
# 1=不连 Java，工具走本地假数据（先联调 Agent 用）；0=真实回调 Java /internal/**
MOCK_JAVA=1

# ==================== RAG 配置（阶段 8 新增，FAQ 向量检索） ====================
# FAQ 题库文件名（默认与 config.py 同目录），首次启动时由 faq_rag.py 加载向量化
FAQ_DATA_PATH=faq_grounded.json
# 嵌入模型：bge-m3，中英多语 + 长文本 + 1024 维；首次约 2.2GB 从 HF 镜像下载
EMBED_MODEL=BAAI/bge-m3
# 检索 top-k：召回几条拼进 prompt，3 是经验起点（太少漏答 / 太多稀释上下文）
RAG_TOP_K=3
# 模型缓存目录，默认项目下 models/（已 .gitignore），避免下载到 C 盘；空=HuggingFace 默认 ~/.cache/huggingface
RAG_MODEL_CACHE_DIR=models
# Chroma 向量库持久化目录（相对 config.py 同目录），进程重启不丢索引（已 .gitignore）
RAG_CHROMA_PATH=chroma_data
# HuggingFace 镜像，国内必填，否则连 huggingface.co 会卡死/403
HF_ENDPOINT=https://hf-mirror.com
